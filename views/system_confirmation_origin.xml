<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="system_confirmation_origin_list" model="ir.ui.view">
        <field name="name">system.confirmation.origin.list</field>
        <field name="model">system.confirmation.origin</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="system_confirmation_origin_form" model="ir.ui.view">
        <field name="name">system.confirmation.origin.form</field>
        <field name="model">system.confirmation.origin</field>
        <field name="arch" type="xml">
            <form string="Origin">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_system_confirmation_origin" model="ir.actions.act_window">
        <field name="name">Origins</field>
        <field name="res_model">system.confirmation.origin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an Origin</p>
            <p>Origins are required on every colis.</p>
        </field>
    </record>
</odoo>
