<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.system.confirmation</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="System Confirmation" id="system_confirmation" string="System Confirmation" name="system_confirmation">
                    <block title="QuickLivraison" name="system_confirmation_quicklivraison">
                        <setting string="API" help="Key and district used to send colis to QuickLivraison.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="quicklivraison_api_key"/>
                                </div>
                                <div class="mt8">
                                    <field name="quicklivraison_district_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="External API" name="system_confirmation_external">
                        <setting string="API Token" help="Secret token that external callers must send (field 'token') to the /create_package route.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="system_confirmation_api_token"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Allowed Locations" name="system_confirmation_allowed_location">
                        <setting string="Allowed Locations" help="location that is allowed for system confirmation.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="system_confirmation_allowed_location_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Quick livraison" name="system_confirmation_quicklivraison_logo">
                        <setting string="Logo de Quicklivraison" help=" .">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="system_confirmation_quicklivraison_logo" />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="OPENAI API" name="system_confirmation_openai_api_key">
                        <setting string="OPENAI API KEY" help=" .">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="system_confirmation_open_api_key" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_system_confirmation_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'system_confirmation'}</field>
    </record>
</odoo>
