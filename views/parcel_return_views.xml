<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="system_confirmation_return_form" model="ir.ui.view">
        <field name="name">system.confirmation.return.form</field>
        <field name="model">system.confirmation.return</field>
        <field name="arch" type="xml">
            <form string="Parcel Return">
                <header>
                    <button name="action_validate" string="Validate Return" type="object" class="btn-primary" invisible="state == 'done'" groups="system_confirmation.group_system_confirmation_return_validator"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="colis_id"/>
                            <field name="source"/>
                            <field name="tracking_package_id" invisible="not tracking_package_id"/>
                        </group>
                        <group>
                            <field name="registered_by"/>
                            <field name="registered_at"/>
                            <field name="validated_by" invisible="not validated_by"/>
                            <field name="validated_at" invisible="not validated_at"/>
                            <field name="error_message" invisible="not error_message"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="colis_line_id" column_invisible="True"/>
                            <field name="shipped_quantity"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                    <field name="stock_move_ids" widget="many2many_tags" readonly="1" invisible="not stock_move_ids"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="system_confirmation_return_wizard_form" model="ir.ui.view">
        <field name="name">system.confirmation.return.wizard.form</field>
        <field name="model">system.confirmation.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Return">
                <group>
                    <field name="colis_id"/>
                    <field name="return_type" widget="radio"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id"/>
                        <field name="colis_line_id" column_invisible="True"/>
                        <field name="shipped_quantity"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_register" string="Register" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
