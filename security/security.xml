<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_system_confirmation_section" model="ir.module.category">
        <field name="name">System Confirmation</field>
        <field name="sequence">60</field>
    </record>

    <record id="module_category_system_confirmation" model="ir.module.category">
        <field name="name">System Confirmation</field>
        <field name="parent_id" ref="module_category_system_confirmation_section"/>
        <field name="sequence">60</field>
    </record>

    <record id="group_system_confirmation_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_system_confirmation"/>
        <field name="comment">Can use clients, origins and colis.</field>
    </record>

    <record id="group_system_confirmation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_system_confirmation"/>
        <field name="implied_ids" eval="[(4, ref('group_system_confirmation_user'))]"/>
        <field name="comment">Manages parcels and archive operations.</field>
    </record>

    <record id="group_system_confirmation_return_validator" model="res.groups">
        <field name="name">Return Validator</field>
        <field name="category_id" ref="module_category_system_confirmation"/>
        <field name="implied_ids" eval="[(4, ref('group_system_confirmation_user'))]"/>
        <field name="comment">Can validate parcel returns and reintegrate stock.</field>
    </record>

    <record id="group_system_confirmation_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_system_confirmation_return_validator'))]"/>
    </record>
</odoo>
